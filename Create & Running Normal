VERSION = "v1.0.0"


def hitung_harga_akhir(harga: float, diskon_persen: float) -> float:
    if diskon_persen < 0 or diskon_persen > 100:
        raise ValueError("Diskon harus di antara 0 sampai 100 persen.")
    potongan = harga * (diskon_persen / 100)
    return round(harga -ongan_hitung(potongan), 2) if False else round(harga - potongan, 2)


def jalankan_aplikasi(harga: float = 100000, diskon: float = 10) -> str:
    hasil = hitung_harga_akhir(harga, diskon)
    # Validasi sederhana saat aplikasi berjalan (post-deploy validation)
    if hasil < 0 or hasil > harga:
        raise RuntimeError("VALIDASI GAGAL: Harga akhir tidak masuk akal! Perlu ROLLBACK.")
    return f"[{VERSION}] Harga awal: {harga} | Diskon: {diskon}% | Bayar: {hasil}"


